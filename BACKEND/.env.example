# Copy to .env and fill in. Never commit .env — it is gitignored.
# In production set these in your host's dashboard (Render), not in a file.

# --- Core ---
NODE_ENV=development
PORT=8070
MONGODB_URL=
JWT_SECRET=

# --- URLs (no trailing slash) ---
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8070

# --- Mail (Gmail needs a 16-char App Password, not the account password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Yong SMART

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Python sentiment model ---
# Leave PY_HELPER_ABS_PATH unset; pythonService.js resolves it relative to the module.
PYTHON_BIN=python
