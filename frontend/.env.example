# Copy to .env and fill in. Vite inlines VITE_* at BUILD time,
# so changing these in production requires a rebuild.

# Backend origin, no trailing slash.
# Production example: https://yongsmart-api.onrender.com
VITE_API_BASE_URL=http://localhost:8070

# Gemini endpoint for the chatbot.
# WARNING: anything in a VITE_ variable is compiled into the JavaScript
# every visitor downloads - it is public, not secret. Proxy this through
# the backend before going live rather than shipping a usable key.
VITE_API_URL=
