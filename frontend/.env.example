# Copy to .env and fill in. Vite inlines VITE_* at BUILD time,
# so changing these in production requires a rebuild.
#
# Nothing secret belongs here: every VITE_ value is compiled into the
# JavaScript each visitor downloads. Keys live in BACKEND/.env.

# Backend origin, no trailing slash.
# Production example: https://yongsmart-api.onrender.com
VITE_API_BASE_URL=http://localhost:8070
